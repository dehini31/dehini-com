# Retour de PayPal : la page ne charge aucun script tiers (le paiement a lieu sur paypal.com). Politique stricte :
# rien d'autre que le site lui-même, aucune intégration dans un cadre.
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header set Referrer-Policy "no-referrer"
  Header set X-Robots-Tag "noindex"
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Lien de partage d'un Studio : /studioma/s/<clé>[/card/<n°>] (voir s.php).
  RewriteRule ^s/([A-Za-z0-9_-]{32})(/card/([0-9]+))?/?$ s.php?t=$1&c=$3 [L,QSA]
  # Parcours du créateur : vérification publique d'une réalisation et passeport public (voir p.php).
  RewriteRule ^verify/([a-f0-9]{16})/?$ p.php?verify=$1 [L,QSA]
  RewriteRule ^creator/([a-z0-9-]{1,40})/?$ p.php?creator=$1 [L,QSA]
  # Pages publiques rendues par le serveur : opportunités, prix, plan du site (voir p.php).
  RewriteRule ^opportunities/?$ p.php?opps=1 [L,QSA]
  RewriteRule ^opportunity/([0-9]{1,10})(-[^/]*)?/?$ p.php?opp=$1&slug=$2 [L,QSA]
  RewriteRule ^pricing/?$ p.php?pricing=1 [L,QSA]
  RewriteRule ^sitemap\.xml$ p.php?sitemap=1 [L,QSA]
  # Certains hébergeurs retirent l'en-tête Authorization avant PHP : on le transmet (serveur MCP, OAuth).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # Assistants IA : serveur MCP, OAuth et documents de découverte (voir mcp.php et oauth.php).
  RewriteRule ^mcp/?$ mcp.php [L,QSA]
  RewriteRule ^oauth/(register|authorize|token|revoke)/?$ oauth.php?op=$1 [L,QSA]
  RewriteRule ^\.well-known/(oauth-protected-resource|oauth-authorization-server|openid-configuration)(/.*)?$ oauth.php?wk=$1 [L,QSA]
</IfModule>

# Seuls les pages, l'API et les fichiers statiques sont accessibles.
<FilesMatch "^(config\.php|config\.example\.php|\.user\.ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Aucun script en ligne : le contenu saisi par les membres ne peut pas s'exécuter.
  # accounts.google.com/gsi : le bouton « Continue with Google » (script, fenêtre et style de Google).
  # connect.facebook.net, www.facebook.com : le pixel Meta (assets/meta.js, sans script en ligne).
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.facebook.com; media-src 'self' blob:; connect-src 'self' https://accounts.google.com/gsi/ https://www.facebook.com https://connect.facebook.net; frame-src https://accounts.google.com/gsi/; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  <FilesMatch "\.(html|json|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

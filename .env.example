# Noms des réglages de paiement de Studioma (Paddle Billing) — modèle SANS AUCUNE VALEUR RÉELLE.
#
# Ne jamais mettre de vraie clé, de vrai jeton ni de vrai secret dans ce fichier, dans Git ou dans une conversation.
# Sur l'hébergement, les valeurs vont dans ~/public_html/studioma/config.php (git-ignoré ; modèle :
# studioma/config.example.php) sous la forme  define('STM_PADDLE_ENV', 'production');  — ou, à défaut, dans des
# variables d'environnement du même nom (lib/billing.php › billing_cfg : la constante de config.php passe d'abord).
# Les fichiers .env réels sont git-ignorés ; seul ce modèle est suivi. Guide complet : docs/billing.md.

# Ouvre le paiement en ligne (sinon les formules payantes affichent « Coming soon »).
STM_BILLING_ENABLED=false
# Limites des formules appliquées (true par défaut ; false = tout le monde garde l'usage actuel).
STM_PLANS_ENFORCED=true

# Environnement Paddle : exactement « sandbox » ou « production » (toute autre valeur garde le paiement fermé).
STM_PADDLE_ENV=sandbox
# Clé d'API serveur (secrète) — sandbox : pdl_sdbx_apikey_… ; production : pdl_live_apikey_…
STM_PADDLE_API_KEY=pdl_sdbx_apikey_REPLACE_ME
# Jeton côté client pour Paddle.js (public) — sandbox : test_… ; production : live_…
STM_PADDLE_CLIENT_TOKEN=test_REPLACE_ME
# Secret de la destination de notifications (webhook https://<site>/studioma/paddle-webhook.php) : pdl_ntfset_…
STM_PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME

# Identifiants des 4 prix (différents en sandbox et en production : voir la table de correspondance de docs/billing.md).
STM_PADDLE_PRICE_SOLO_MONTHLY=pri_REPLACE_ME
STM_PADDLE_PRICE_SOLO_YEARLY=pri_REPLACE_ME
STM_PADDLE_PRICE_TEAM_MONTHLY=pri_REPLACE_ME
STM_PADDLE_PRICE_TEAM_YEARLY=pri_REPLACE_ME

# Noms des réglages de paiement de Studioma (PayPal) — modèle SANS AUCUNE VALEUR RÉELLE.
#
# Ne jamais mettre de vrai identifiant secret dans ce fichier, dans Git ou dans une conversation.
# Sur l'hébergement, les valeurs vont dans ~/public_html/studioma/config.php (git-ignoré ; modèle :
# studioma/config.example.php) sous la forme  define('STM_PAYPAL_ENV', 'live');  — ou, à défaut, dans des
# variables d'environnement du même nom (lib/billing.php › billing_cfg : la constante de config.php passe d'abord).
# Les fichiers .env réels sont git-ignorés ; seul ce modèle est suivi. Guide complet : docs/billing.md.

# Ouvre le paiement en ligne (sinon les formules payantes affichent « Coming soon »).
STM_BILLING_ENABLED=false
# Limites des formules appliquées (true par défaut ; false = tout le monde garde l'usage actuel).
STM_PLANS_ENFORCED=true

# Environnement PayPal : exactement « sandbox » ou « live » (toute autre valeur garde le paiement fermé).
STM_PAYPAL_ENV=sandbox
# Application PayPal (developer.paypal.com › Apps & Credentials) : identifiant client et secret (SECRET).
STM_PAYPAL_CLIENT_ID=REPLACE_ME
STM_PAYPAL_SECRET=REPLACE_ME
# ID du webhook (https://<site>/studioma/paypal-webhook.php) affiché par PayPal — un identifiant, pas un secret.
STM_PAYPAL_WEBHOOK_ID=REPLACE_ME

# Identifiants des 4 formules PayPal (P-…), différents en sandbox et en live ; créés par l'administration › Billing.
STM_PAYPAL_PLAN_SOLO_MONTHLY=P-REPLACE_ME
STM_PAYPAL_PLAN_SOLO_YEARLY=P-REPLACE_ME
STM_PAYPAL_PLAN_TEAM_MONTHLY=P-REPLACE_ME
STM_PAYPAL_PLAN_TEAM_YEARLY=P-REPLACE_ME

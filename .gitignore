# data.json suivi par Git n'est que le CONTENU INITIAL (sert à amorcer le
# serveur au premier déploiement). Une fois installé, il est modifié depuis
# /admin directement sur le serveur et n'est plus synchronisé avec Git — le
# déploiement automatique ne le touche plus jamais (voir README.md).

# Secrets : jamais commités.
/admin/config.php
/impact/config.php
/metakpis/config.php
/marketing/config.php
/swanbida/config.php
/maillage/config.php

# Images envoyées depuis /admin.
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess

# Photos et vidéos envoyées depuis l'admin de SWANBIDA.
/swanbida/media/*
!/swanbida/media/.gitkeep
!/swanbida/media/.htaccess

# Logos des pages pro du défi Impact (envoyés depuis le site).
/impact/uploads/pros/*
!/impact/uploads/pros/.gitkeep

# Photos de produits et logos envoyés depuis l'espace entreprise de Maillage.
/maillage/media/*
!/maillage/media/.gitkeep
!/maillage/media/.htaccess
